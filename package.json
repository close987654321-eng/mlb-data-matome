{
  "name": "mlb-data-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --require $(pwd)/scripts/patch-graceful-fs.cjs\" next build",
    "build:gate": "bash scripts/build-gate.sh",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:images": "node scripts/check-discover-images.mjs",
    "ping": "node scripts/ping-indexnow.mjs"
  },
  "dependencies": {
    "graceful-fs": "^4.2.11",
    "next": "^15.0.0",
    "next-intl": "^4.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "and_chr >= 111",
    "samsung >= 21"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
